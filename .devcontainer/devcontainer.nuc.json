{
    "name": "Creating Autonomous Car (Jazzy)",
    "privileged": true,
    "remoteUser": "${localEnv:USER}",
    "image": "creating_autonomous_car_ros2:jazzy",
    "workspaceFolder": "/ws/src/creating_autonomous_car/",
    "workspaceMount": "source=${localWorkspaceFolder},target=/ws/src/creating_autonomous_car,type=bind",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack",
                "ms-python.python",
                "ms-iot.vscode-ros",
                "twxs.cmake",
                "redhat.vscode-xml",
                "foxundermoon.shell-format"
            ]
        }
    },
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "XAUTHORITY": "/tmp/.Xauthority",
        "ROS_DOMAIN_ID": "1",
        "RMW_IMPLEMENTATION": "rmw_cyclonedds_cpp"
    },
    "runArgs": [
        "--name", "creating_autonomous_car",
        "--net", "host",
        "--privileged",
        "--device", "/dev/dri:/dev/dri"
    ],
    "mounts": [
        "source=${localEnv:HOME}/.Xauthority,target=/tmp/.Xauthority,type=bind,consistency=cached",
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
        "source=/dev/input,target=/dev/input,type=bind",
        "source=${localWorkspaceFolder}/../cache/build,target=/ws/build,type=bind",
        "source=${localWorkspaceFolder}/../cache/install,target=/ws/install,type=bind",
        "source=${localWorkspaceFolder}/../cache/log,target=/ws/log,type=bind",
        "source=${localEnv:HOME}/.ssh,target=/home/${localEnv:USER}/.ssh,type=bind,consistency=cached",
        "source=/dev,target=/dev,type=bind"
    ],
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "postStartCommand": "sudo chmod 666 /dev/dri/card* /dev/dri/renderD* 2>/dev/null || true"
}